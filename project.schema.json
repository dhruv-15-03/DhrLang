{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DhrLang ordered local project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compilerVersion", "profile", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "compilerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "profile": { "const": "jvm-bytecode-v1" },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "input": { "type": ["string", "null"], "maxLength": 65536 },
    "limits": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["timeoutMs", "maxSteps", "heapMb", "maxOutputBytes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "maxSteps": { "type": "integer", "minimum": 100, "maximum": 5000000 },
        "heapMb": { "type": "integer", "minimum": 32, "maximum": 256 },
        "maxOutputBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 }
      }
    }
  }
}
