# VS Code Extension ignore file

# NOTE: Removed 'out/' ignore so compiled extension code is included in VSIX

# Source maps
*.map

# Node modules: vsce prunes this to production ("dependencies") entries only,
# so vscode-languageclient (a runtime dependency, required by the Language
# Server client) ships in the VSIX while devDependencies (typescript, @types/*)
# are excluded. Do NOT blanket-ignore node_modules/ here.

# Keep TypeScript sources out (only ship compiled JS)
src/

# Development files
.vscode/
.vscode-test/
*.vsix
test/

# Build files
tsconfig.json
.eslintrc.json

# Images not needed in package (keep only the ones referenced in package.json)
images/icon.svg